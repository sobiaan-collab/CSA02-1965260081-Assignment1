#include <stdio.h>

int main(void)
{
    int a = 5, b = 2;
    float x = 5.0f, y = 2.0f;

    printf("Integer division: %d\n", a / b);
    printf("Floating-point division: %.2f\n", x / y);
    printf("Integer division converted to float: %.2f\n",
           (float)(a / b));
    printf("Correct floating-point conversion: %.2f\n",
           (float)a / b);

    printf("0.1 + 0.2 using float: %.10f\n", 0.1f + 0.2f);

    long amount = 123456789L;
    printf("Amount in paise: %ld\n", amount);
    printf("Amount converted to int: %d\n", (int)amount);

    return 0;
}
